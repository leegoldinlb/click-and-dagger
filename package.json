{
  "name": "click-and-dagger",
  "version": "1.4.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30",
    "electron-builder": "^24"
  },
  "build": {
    "appId": "com.clickanddagger.app",
    "productName": "Click and Dagger",
    "files": [
      "index.html",
      "editor.html",
      "help.html",
      "*.css",
      "js/**/*",
      "assets/**/*",
      "missions/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.icns",
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    }
  }
}
